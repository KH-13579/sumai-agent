# スマイエージェント — 環境設定
# Ollama をローカルで起動したうえで以下を設定してください

# ─── モデル選択 ────────────────────────────────────────────────
# PC スペック別の目安:
#   低スペック / 速度優先:            qwen2.5:3b   ← 既定・初期フェーズはチーム全員この値
#   標準PC:                          qwen2.5:7b   ← バランス（間取りが1案に減る実測あり）
#   高性能PC / GPU搭載 (VRAM 8GB+):   qwen2.5:14b  ← 高品質・低速
#   代替モデル:                       llama3.2:3b / gemma3:4b
SUMAI_MODEL=qwen2.5:3b

# Ollama サーバーのURL（通常は変更不要）
OLLAMA_BASE_URL=http://localhost:11434

# 応答の多様性（0.0=一定, 1.0=多様。0.3が住宅提案には適切）
SUMAI_TEMPERATURE=0.3

# ─── LLM応答のキャッシュ（NFR-06 オフライン再生 / NFR-01 再現性）────
#   off    … 常に実機のLLMを呼ぶ（既定・開発時）
#   auto   … キャッシュがあれば返し、無ければ実機を呼んで保存（デモ準備・本番）
#   replay … キャッシュのみを使う。無ければエラー（デモ前の最終確認）
#   record … 常に実機を呼んでキャッシュを上書き（プロンプト変更後の作り直し）
SUMAI_LLM_CACHE=off

# ─── 法規チェックAI ──────────────────────────────────────────
# 1 にすると法規NG時に上限値を制約として間取りを再生成し、再チェックする（最大1回）。
# 間取り生成が2回走るため応答時間は約2倍になる。
SUMAI_LEGAL_AUTOFIX=0

# 不動産情報ライブラリ（国土交通省）API キー。
# 空でも動作する（対象自治体のプリセット値 → 標準的な敷地条件の仮定値へフォールバック）。
REINFOLIB_API_KEY=
