# スマイエージェント — 環境設定
# Ollama をローカルで起動したうえで以下を設定してください

# ─── モデル選択 ────────────────────────────────────────────────
# 【推奨】PC スペック別のモデル選択:
#   高性能PC / GPU搭載 (VRAM 8GB+): qwen2.5:14b  ← 高品質・低速
#   標準PC / GPU非搭載:              qwen2.5:7b   ← バランス（デフォルト）
#   低スペックPC / 速度優先:          qwen2.5:3b   ← 高速・低品質
#   代替モデル:                       llama3.2:3b / gemma3:4b
SUMAI_MODEL=qwen2.5:3b

# Ollama サーバーのURL（通常は変更不要）
OLLAMA_BASE_URL=http://localhost:11434

# 応答の多様性（0.0=一定, 1.0=多様。0.3が住宅提案には適切）
SUMAI_TEMPERATURE=0.3
